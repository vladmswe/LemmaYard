# Node sandbox image (PLAN.md section 5). Build with `pnpm sandbox:build`.
# Base pinned by tag and multi-arch digest.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

# Package managers are not needed at run time.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

COPY --chown=0:0 --chmod=0444 harness.js /sandbox/harness.js
RUN chmod 0555 /sandbox

WORKDIR /tmp
USER 65534:65534
# The worker passes this command explicitly, with --max-old-space-size derived
# from the problem's memory limit (worker/docker-executor.ts).
CMD ["node", "/sandbox/harness.js"]
