{
  "name": "leet-copy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "worker": "node scripts/not-implemented.mjs worker M4",
    "dev:all": "node scripts/not-implemented.mjs dev:all M4",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "node scripts/not-implemented.mjs test:e2e M7",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "pnpm db:migrate && pnpm problems:import",
    "problems:import": "tsx scripts/import-problems.ts",
    "problems:verify": "node scripts/not-implemented.mjs problems:verify M4",
    "sandbox:build": "tsx scripts/sandbox-build.ts",
    "setup": "node scripts/not-implemented.mjs setup M4"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  }
}
