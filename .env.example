# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Database (docker compose Postgres 16, see docker-compose.yml)
DATABASE_URL=postgres://leetcopy:leetcopy@localhost:5433/leetcopy
# Production (Supabase), see docs/DEPLOY.md: DATABASE_URL = transaction pooler
# (port 6543). DATABASE_URL_DIRECT = session pooler / direct connection, used
# only by db:migrate, db:seed and problems:import (falls back to DATABASE_URL).
DATABASE_URL_DIRECT=
# TLS: disable | require (verified) | no-verify. Unset: the URL's sslmode,
# else disable for localhost, no-verify for remote hosts.
DATABASE_SSL=
# PEM CA for DATABASE_SSL=require (one line with \n is fine).
DATABASE_SSL_CA=
# Connections per process; default 1 on Vercel, 10 elsewhere.
DATABASE_POOL_MAX=
TEST_DATABASE_URL=postgres://leetcopy:leetcopy@localhost:5433/leetcopy_test
# Integration tests create and migrate leetcopy_test_<suffix> on the TEST_DATABASE_URL
# server. Suffix defaults to the git worktree directory name; set to override.
TEST_DB_SUFFIX=

# Auth: generate a secret with `openssl rand -base64 32` (min 32 chars).
# The placeholder below works locally but is rejected in production (Vercel,
# or NODE_ENV=production with a non-localhost AUTH_URL).
AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
AUTH_URL=http://localhost:3000
# Login/register rate limits: 1 (default). 0 only for local Playwright runs;
# rejected on Vercel.
AUTH_RATE_LIMITS=1

# Web server port (read by `pnpm dev` / `pnpm start` via node --env-file)
PORT=3000

# Worker
WORKER_CONCURRENCY=2
WORKER_POLL_MS=500
STALE_RUNNING_MIN=3
WALL_CAP_MS=30000

# Sandbox images (built by `pnpm sandbox:build`)
SANDBOX_IMAGE_PYTHON=lemmayard-sandbox-python:latest
SANDBOX_IMAGE_NODE=lemmayard-sandbox-node:latest
# Sandbox containers carry lemmayard.ns=<namespace>; the worker removes only
# leftovers of its own namespace. Empty: checkout directory name + path hash,
# so every worktree has its own. The e2e harness uses "<default>-e2e".
SANDBOX_NAMESPACE=
LANG_TIME_MULT_PY=2
LANG_TIME_MULT_JS=1

# Limits
RUN_RATE_PER_MIN=10
SUBMIT_RATE_PER_MIN=5
MAX_ACTIVE_PER_USER=2
MAX_CODE_BYTES=65536
PAGE_SIZE=20
QUEUED_TIMEOUT_MS=60000

# Guide (/learn): 1 enables /learn/dev-fixtures/* (Playwright only; keep 0)
GUIDE_FIXTURES=0

# Code execution (Run / Submit / room session start): 1 on, 0 off.
# Unset: off on Vercel (VERCEL is set there, no judge worker), on elsewhere.
JUDGE_ENABLED=
